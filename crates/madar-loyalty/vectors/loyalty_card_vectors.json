        "progress_to_next": 3,
        "points_to_next_reward": 2,
        "can_redeem": false
      }
    },
    {
      "name": "exactly_one_reward",
      "why": "5 / 5 = 1 earned, 5 % 5 = 0 on the next card, 5 − 0 = 5 to go (a fresh card on an exact multiple)",
