[
  {
    "name": "latte_shot_follows_decaf",
    "about": "The server's capture (MadarRust catalog_pricing_tests): Decaf swapped in for the espresso bean, an extra shot authored as espresso becomes 18 g of the decaf bean.",
    "lines": [
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000027",
        "name": "Decaf bean",
        "unit": "g",
        "quantity": 36.0,
        "category": "coffee_bean",
        "additive": false
      },
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000020",
        "name": "Whole milk",
        "unit": "ml",
        "quantity": 400.0,
        "category": "milk",
        "additive": false
      },
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000026",
        "name": "Espresso bean",
        "unit": "g",
        "quantity": 18.0,
        "category": "coffee_bean",
        "additive": true
      }
    ],
    "families": [
      "milk",
      "coffee_bean"
    ],
    "expect_lines": [
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000027",
        "name": "Decaf bean",
        "unit": "g",
        "quantity": 36.0,
        "category": "coffee_bean",
        "additive": false
      },
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000020",
        "name": "Whole milk",
        "unit": "ml",
        "quantity": 400.0,
        "category": "milk",
        "additive": false
      },
      {
        "ingredient_id": "c0de0000-0000-4000-8000-000000000027",
        "name": "Decaf bean",
        "unit": "g",
        "quantity": 18.0,
        "category": "coffee_bean",
        "additive": true
      }
    ],
    "expect_followed": [
      {
        "kind": "followed",
        "line": 2,
        "from": "Espresso bean",
        "to": "Decaf bean"
      }
    ]
  },
