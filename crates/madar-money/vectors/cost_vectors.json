    {"name": "missing_cost_partial_sum", "lines": [{"qty": 18, "cost_per_unit": 0.4}, {"qty": 200, "cost_per_unit": null}], "expected": {"piastres": 7, "complete": false}, "why": "7.2 known; the milk is unknown"},
    {"name": "nothing_costed", "lines": [{"qty": 18, "cost_per_unit": null}], "expected": {"piastres": 0, "complete": false}, "why": "the server's figure is null here"},
    {"name": "d4_price_1000_lines_400_4", "lines": [{"qty": 18, "cost_per_unit": 12.8}, {"qty": 170, "cost_per_unit": 1}], "expected": {"piastres": 400, "complete": true}, "why": "230.4 + 170 = 400.4 → 400; margin over 1000 is then 0.6"},
    {"name": "rounded_once_not_per_line", "lines": [{"qty": 1, "cost_per_unit": 0.4}, {"qty": 1, "cost_per_unit": 0.4}, {"qty": 1, "cost_per_unit": 0.4}], "expected": {"piastres": 1, "complete": true}, "why": "1.2 → 1; per line it would be 0 + 0 + 0"},
    {"name": "halves_sum_before_rounding", "lines": [{"qty": 1, "cost_per_unit": 0.5}, {"qty": 1, "cost_per_unit": 0.5}], "expected": {"piastres": 1, "complete": true}, "why": "1.0; per line it would be 1 + 1"},
    {"name": "half_piastre_total_rounds_away_from_zero", "lines": [{"qty": 1, "cost_per_unit": 0.25}, {"qty": 1, "cost_per_unit": 0.25}], "expected": {"piastres": 1, "complete": true}},
    {"name": "latte", "lines": [{"qty": 18, "cost_per_unit": 0.4}, {"qty": 200, "cost_per_unit": 0.35}, {"qty": 1, "cost_per_unit": 150}], "expected": {"piastres": 227, "complete": true}, "why": "7.2 + 70 + 150 = 227.2"}
