{
  "about": "madar_money::cost — hand-computed. Inputs are read as the decimal they print as (0.35 is 0.35, not 0.3499999…), multiplied exactly and rounded half away from zero to whole piastres (MadarRust costing::service::round_piastres). A recipe sums its known lines exactly and rounds once; a cost of 0 is known, a null cost makes it incomplete. margin = (price − cost) / price over the rounded cost, null unless price > 0. food_cost_band: good when cost×100 < 30×price, fair when ≤ 40×price, else poor; null unless price > 0.",
  "line_cost": [
    {"name": "espresso_18g_at_0_4", "qty": 18, "cost_per_unit": 0.4, "expected": 7},
    {"name": "cost_zero_is_free", "qty": 18, "cost_per_unit": 0, "expected": 0},
    {"name": "qty_zero", "qty": 0, "cost_per_unit": 125, "expected": 0},
    {"name": "whole_piastres", "qty": 2, "cost_per_unit": 1250, "expected": 2500},
    {"name": "half_piastre_rounds_away_from_zero_not_to_even", "qty": 1, "cost_per_unit": 2.5, "expected": 3},
    {"name": "half_piastre_from_half_a_unit", "qty": 0.5, "cost_per_unit": 1, "expected": 1},
    {"name": "negative_half_rounds_away_from_zero", "qty": -0.5, "cost_per_unit": 1, "expected": -1},
    {"name": "decimal_not_binary_expansion", "qty": 0.35, "cost_per_unit": 10, "expected": 4, "why": "0.35 × 10 = 3.5 → 4; the binary 0.34999999999999997779 × 10 would give 3"},
    {"name": "f64_product_would_round_down", "qty": 1.015, "cost_per_unit": 100, "expected": 102, "why": "1.015 × 100 = 101.5 → 102; in f64 it is 101.49999999999999 → 101"},
    {"name": "milk_250ml_at_0_35", "qty": 250, "cost_per_unit": 0.35, "expected": 88},
    {"name": "sub_piastre_rounds_to_zero", "qty": 1, "cost_per_unit": 0.4, "expected": 0},
    {"name": "cheap_per_gram_large_qty", "qty": 12000, "cost_per_unit": 0.123456, "expected": 1481, "why": "1481.472"}
  ],
